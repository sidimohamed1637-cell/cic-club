# إعدادات Firebase السحابية لنادي الإبداع والابتكار (STI)
# قم بإنشاء مشروع في https://console.firebase.google.com وانسخ المفاتيح هنا
# ثم احفظ هذا الملف باسم .env.local في المجلد الرئيسي للمشروع

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=sti-club-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sti-club-project
VITE_FIREBASE_STORAGE_BUCKET=sti-club-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
